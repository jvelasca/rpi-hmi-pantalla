[Unit]
Description=RPi HMI Backend (FastAPI)
Documentation=https://github.com/jvelasca/rpi-hmi-pantalla
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=pi
Group=pi
WorkingDirectory=/home/pi/rpi_hmi
Environment=PATH=/usr/bin:/usr/local/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/rpi_hmi/venv/bin/python3 -m uvicorn backend.app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
WatchdogSec=30
StandardOutput=journal
StandardError=journal

# ── Limites de recursos ────────────────────────────────────
# MemoryMax: limita la RAM (RSS+swap) del proceso. 256M cubre el backend
#   FastAPI + uvicorn en una Pi con 1 GB; ajustar si se anaden features.
MemoryMax=256M
# CPUQuota: % de CPU sobre el total de nucleos (100% = 1 nucleo). Evita
#   que un bucle anormal acapare la CPU de la Pi (un solo nucleo en Pi Zero/W).
CPUQuota=100%
# TasksMax: numero maximo de procesos/hilos. Suficiente para uvicorn,
#   el pool de threads de asyncio.to_thread y subprocesses de nmcli.
TasksMax=256
# LimitNOFILE: descriptores de fichero max. Asegura que no se agote con
#   muchas conexiones WebSocket simultaneas.
LimitNOFILE=65536
# UMask: permisos restrictivos para ficheros/dirs creados (0700/0600).
UMask=0077

# ── Hardening ──────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/home/pi/rpi_hmi/data /home/pi/rpi_hmi/backend/config /dev/gpiomem /sys/class/gpio
ReadOnlyPaths=/sys/class/thermal

# ── Watchdog (ACTIVO) ────────────────────────────────────────
# El servicio notifica a systemd via sd_notify implementado en
# backend/app/services/systemd_notify.py:
#   - READY=1 al terminar el arranque (notify_ready).
#   - WATCHDOG=1 periodicamente (notify_watchdog, cada WatchdogSec/2).
#   - STOPPING=1 al apagar (notify_stopping).
# Con Type=notify, systemd considera el arranque fallido si el proceso
# no envia READY=1 en un plazo; con WatchdogSec=30 reinicia el servicio
# si no recibe WATCHDOG=1 en 30 s. Sin systemd (dev/CI/Windows) el
# modulo no hace nada (no-op).

[Install]
WantedBy=multi-user.target
