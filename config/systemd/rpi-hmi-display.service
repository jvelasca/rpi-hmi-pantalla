[Unit]
Description=RPi HMI Display (Pygame DRM/KMS)
Documentation=https://github.com/user/rpi_hmi
After=network-online.target rpi-hmi-backend.service
Wants=network-online.target rpi-hmi-backend.service
Requires=rpi-hmi-backend.service
Conflicts=lightdm.service

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=video,input,render
WorkingDirectory=/home/pi/rpi_hmi
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_KMSDRM_DEVICE_INDEX=0
Environment=SDL_RENDER_DRIVER=software
Environment=PYTHONPATH=/home/pi/rpi_hmi
Environment=PYTHONUNBUFFERED=1

# Esperar a que el backend responda (max 30s, usa /health/ready + HTTP status)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do curl -fsS http://localhost:8000/health/ready >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'

# Desvincular consola virtual de fb1 (ili9486) para que no escriba en la TFT
ExecStartPre=/bin/sh -c 'test -w /sys/class/vtconsole/vtcon1/bind && echo 0 > /sys/class/vtconsole/vtcon1/bind || true'

# Lanzar la app HMI en la TFT (ili9486)
ExecStart=/home/pi/rpi_hmi/venv/bin/python3 -m display.app --api-url http://localhost:8000

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# ── Hardening (permisivo por DRM/input) ──────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
RestrictSUIDSGID=true
LockPersonality=true
# No usamos ProtectSystem=strict porque necesita acceso a /dev/dri y /dev/input
ReadWritePaths=/home/pi/rpi_hmi/data /dev/dri /dev/input /sys/class/vtconsole

[Install]
WantedBy=multi-user.target
