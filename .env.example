# ═══════════════════════════════════════════════════════════════
# Rpi_Pantalla_V1 — Variables de entorno
# ═══════════════════════════════════════════════════════════════
#
# Copia este archivo como ".env" y ajusta los valores según tu
# configuración de red y credenciales.
#
# El archivo .env NUNCA se commitea al repositorio (está en .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── Conexión SSH a la Raspberry Pi ────────────────────────
RPI_HOST=192.168.1.100
RPI_USER=pi
RPI_PASSWORD=
RPI_KEY_PATH=
RPI_PORT=22
RPI_TIMEOUT=15

# ── Backend ───────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Seguridad ─────────────────────────────────────────────
# API key para endpoints administrativos (/admin/*)
ADMIN_API_KEY=cambia-esto-por-una-clave-segura

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Habilitar documentación OpenAPI (docs/redoc)
ENABLE_DOCS=false

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
