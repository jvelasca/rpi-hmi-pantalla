# ═══════════════════════════════════════════════════════════════
# Rpi_Pantalla_V1 — Variables de entorno
# ═══════════════════════════════════════════════════════════════
#
# Copia este archivo como ".env" y ajusta los valores según tu
# configuración de red y credenciales.
#
# El archivo .env NUNCA se commitea al repositorio (está en .gitignore).
# ═══════════════════════════════════════════════════════════════

# ── Conexión SSH a la Raspberry Pi ────────────────────────
# IP de la Raspberry Pi (ajústala a la de tu red)
RPI_HOST=192.168.1.100
RPI_USER=pi
RPI_PASSWORD=
RPI_KEY_PATH=
RPI_PORT=22
RPI_TIMEOUT=15

# ── Backend ───────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Seguridad ─────────────────────────────────────────────
# ⚠️  ADVERTENCIA: Los endpoints /admin/* permiten SSH remoto y deploy.
#     Mantenlos DESHABILITADOS en produccion (ENABLE_ADMIN_API=false).
#     Solo habilita en desarrollo y con una API key segura.

# Modo de seguridad:
#   local     = HMI sin autenticacion (prototipo domestico)
#   protected = los mutadores HMI (REST + WebSocket) exigen autenticacion:
#               - navegador: cookie de sesion HttpOnly tras POST /api/auth/login
#               - scripts/M2M: header X-API-Key
SECURITY_MODE=local

# Habilitar endpoints administrativos /admin/* (SSH, deploy)
# SOLO para desarrollo. NUNCA habilitar en produccion.
ENABLE_ADMIN_API=false

# API key para endpoints administrativos (/admin/*) y para el login del panel web.
# En SECURITY_MODE=protected, el panel web pide esta clave al entrar y el backend
# emite una cookie de sesion HttpOnly (no queda expuesta en el navegador).
# ⚠️  CAMBIA ESTE VALOR. Genera una clave segura con:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=cambia-esto-por-una-clave-segura

# TTL en segundos de la cookie de sesion del panel web (default: 28800 = 8h)
SESSION_TTL_SECONDS=28800

# Rate-limiting del login (anti brute-force, ventana fija por IP de cliente).
# Se cuentan SOLO los intentos fallidos de POST /api/auth/login; superado el
# limite el backend responde 429 y un login correcto reinicia el contador.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Habilitar documentación OpenAPI (docs/redoc)
ENABLE_DOCS=false

# ── Politica de arranque de actuadores ───────────────────
# Estado inicial de los actuadores al arrancar:
#   off     = siempre apagado
#   restore = restaurar estado persistido (comportamiento por defecto)
#   safe    = restaurar solo si el dispositivo es virtual/seguro
STARTUP_POLICY=restore

# ── Display ──────────────────────────────────────────────
# Resolucion del display fisico en formato WxH (default: 480x320).
# Centraliza el valor que usa el backend al detectar el display (DRM/framebuffer).
DISPLAY_RESOLUTION=480x320

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
