# ═══════════════════════════════════════════════════════════════
# rpi-hmi-frontend — Variables de entorno de Vite
# ═══════════════════════════════════════════════════════════════
#
# Copia este archivo como ".env" dentro de frontend/ para sobrescribir
# la URL del backend durante el desarrollo (npm run dev).
#
# El proxy de Vite (vite.config.ts) reenvía /api, /ws y /health a esta
# URL. En producción el frontend se sirve desde el propio backend
# (mismo origen), por lo que VITE_API_URL no se usa en el build.
# ═══════════════════════════════════════════════════════════════

VITE_API_URL=http://localhost:8000

# ── Opcional: API key para SECURITY_MODE=protected ──────────────
# Si el backend corre en SECURITY_MODE=protected, el frontend (navegador)
# debe autenticarse. El navegador no puede enviar X-API-Key como header en
# WebSocket, asi que se envia como subprotocolo y como header en REST.
# Copia esta variable con el mismo valor de ADMIN_API_KEY del backend .env:
#VITE_API_KEY=cambia-esto-por-una-clave-segura
