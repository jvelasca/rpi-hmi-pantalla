# ═══════════════════════════════════════════════════════════════
# rpi-hmi-frontend — Variables de entorno de Vite
# ═══════════════════════════════════════════════════════════════
#
# Copia este archivo como ".env" dentro de frontend/ para sobrescribir
# la URL del backend durante el desarrollo (npm run dev).
#
# El proxy de Vite (vite.config.ts) reenvía /api, /ws y /health a esta
# URL. En producción el frontend se sirve desde el propio backend
# (mismo origen), por lo que VITE_API_URL no se usa en el build.
#
# AUTENTICACIÓN:
# El panel web ya NO usa VITE_API_KEY. En SECURITY_MODE=protected, el
# navegador hace login contra POST /api/auth/login (con la ADMIN_API_KEY
# del backend) y recibe una cookie de sesión HttpOnly que se envía
# automáticamente en fetch y WebSocket. La clave nunca llega al bundle JS.
# ═══════════════════════════════════════════════════════════════

VITE_API_URL=http://localhost:8000
